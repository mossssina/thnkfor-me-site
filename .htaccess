Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

RewriteEngine On

# ── Canonical: все варианты → https://thnkfor.me (один редирект) ──
# Срабатывает если: http (любой) ИЛИ www (любой протокол)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.thnkfor\.me [NC]
RewriteRule ^ https://thnkfor.me%{REQUEST_URI} [R=301,L]

RewriteBase /

# ── Clean URLs: strip .html extension ────────────────────────
# Redirect /page.html → /page/ (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# Serve directory-style URL from .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Serve trailing-slash URL from .html file (for root-level pages)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1\.html -f
RewriteRule ^(.+)/$ $1.html [L]
